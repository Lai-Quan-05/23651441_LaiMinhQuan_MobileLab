{
  "name": "23651441-mobile-lab",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "export:android": "expo export --platform android --output-dir dist-android",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:start": "node --env-file-if-exists=.env.server.local --import tsx api/start.ts",
    "mockaroo:prepare": "tsx scripts/prepare-mockaroo.ts"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4",
    "react-redux": "^9.3.1",
    "@expo/vector-icons": "15.0.3",
    "expo-font": "58.0.11",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@react-navigation/bottom-tabs": "7.21.0",
    "react-native-paper": "5.15.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
